# Copia este archivo como `.env` y ajusta los valores. `.env` NO se sube a GitHub.

# Clave secreta de Django. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# True solo en desarrollo (necesario para ver los estilos con `runserver`)
DJANGO_DEBUG=True

# Hosts permitidos, separados por comas
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Pon True solo si despliegas detrás de HTTPS (activa cookies seguras)
DJANGO_HTTPS=False
